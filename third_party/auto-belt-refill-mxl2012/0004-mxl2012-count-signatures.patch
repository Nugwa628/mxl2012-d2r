+// ---- the game data the counts need, found by byte signatures at load (no build's fixed addresses) ----
+// Both signatures are taken from D2R 3.3 build 93847 (image 0x6ab3782c, the same image under 3.4 95032) and are unique in its
+// .text; the 93847 RVAs are only for the log. A signature that does not match exactly once turns belt_counts off.
+
+struct Native {
+	const char*   name;
+	const char*   pattern;
+	int           rip;    // >= 0: the disp32 at this offset in the match is the target (invtabs::ResolveNative)
+	std::int64_t  adjust; // else the target is the match + adjust
+	std::uint64_t rva93847;
+};
+
+// HD or legacy graphics (0x846210): `mov rax,[rip+PANELMGR]; test rax,rax; je; movzx eax, byte [rax+0xb9]; ret`, 1 in HD, 0 in
+// legacy. Called as is; the disp32 at +3 (the panel manager global) must point inside the image.
+inline constexpr Native HdModeNative {"hd_mode", "48 8b 05 ?? ?? ?? ?? 48 85 c0 74 08 0f b6 80 b9 00 00 00 c3", -1, 0, 0x846210};
+inline constexpr std::size_t HdModeGlobalDisp = 3;
+
+// The screen size (0x7f4d0): HD asks the HD test (call rel32 at +5) and jumps to the HD size, else it returns the classic
+// screen's width / height, `mov eax,[rip+W]` (disp32 at +0x18) and `mov eax,[rip+H]` (+0x22): 0x22a0d68 / 0x22a0d6c in 93847.
+inline constexpr Native ScreenSizeNative {"screen_size",
+	"48 83 ec 28 e8 ?? ?? ?? ?? 84 c0 74 09 48 83 c4 28 e9 ?? ?? ?? ?? 8b 05 ?? ?? ?? ?? 89 44 24 30 8b 05 ?? ?? ?? ?? 89 44 24 34 "
+	"48 8b 44 24 30 48 83 c4 28 c3",
+	-1, 0, 0x7f4d0};
+inline constexpr std::size_t   ScreenCallDisp      = 5;
+inline constexpr std::size_t   ScreenWidthDisp     = 0x18;
+inline constexpr std::size_t   ScreenHeightDisp    = 0x22;
+inline constexpr std::uint64_t ScreenWidthRva93847 = 0x22a0d68; // for the log only
+
+struct CountNatives {
+	std::int64_t hdMode       = -1;      // RVA of the HD test function
+	std::int64_t screenWidth  = -1;      // RVA of the classic screen width (int32)
+	std::int64_t screenHeight = -1;      // and its height (the next int32)
+	const char*  missing      = nullptr; // the signature that failed, when one did
+	auto ok() const noexcept -> bool { return missing == nullptr; }
+};
+
+// Resolves both signatures in the image (`image`, `imageSize` bytes, .text at `textRva`, `textSize`). Each must match exactly
+// once, the data it points to must lie inside the image and outside .text, the height must follow the width, and the screen
+// function must call the HD test that was found; else `missing` names the failed signature and every RVA stays -1.
+inline auto ResolveCountNatives(const std::uint8_t* image, std::size_t imageSize, std::size_t textRva, std::size_t textSize) noexcept
+	-> CountNatives {
+	const auto fail = [](const char* name) {
+		CountNatives none;
+		none.missing = name;
+		return none;
+	};
+	if (image == nullptr || textRva >= imageSize || textSize > imageSize - textRva) {
+		return fail("image");
+	}
+	const auto isData = [&](std::int64_t rva, std::size_t size) {
+		return rva >= 0 && size <= imageSize && static_cast<std::size_t>(rva) <= imageSize - size
+		       && (static_cast<std::size_t>(rva) + size <= textRva || static_cast<std::size_t>(rva) >= textRva + textSize);
+	};
+	const std::int64_t hd = invtabs::ResolveNative(image, textRva, textSize, HdModeNative);
+	if (hd < 0 || !isData(invtabs::RipTarget(image, static_cast<std::size_t>(hd) + HdModeGlobalDisp), 8)) {
+		return fail(HdModeNative.name);
+	}
+	const std::int64_t screen = invtabs::ResolveNative(image, textRva, textSize, ScreenSizeNative);
+	if (screen < 0) {
+		return fail(ScreenSizeNative.name);
+	}
+	const auto         at     = static_cast<std::size_t>(screen);
+	const std::int64_t width  = invtabs::RipTarget(image, at + ScreenWidthDisp);
+	const std::int64_t height = invtabs::RipTarget(image, at + ScreenHeightDisp);
+	if (invtabs::RipTarget(image, at + ScreenCallDisp) != hd || height != width + 4 || !isData(width, 8)) {
+		return fail(ScreenSizeNative.name);
+	}
+	CountNatives out;
+	out.hdMode       = hd;
+	out.screenWidth  = width;
+	out.screenHeight = height;
+	return out;
+}
