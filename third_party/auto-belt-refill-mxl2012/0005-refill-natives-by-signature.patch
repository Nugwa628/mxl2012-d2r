+// Finds every native by signature (belt_natives.h). All or nothing: when a required one is missing the pointers stay
+// null, no hook is installed and the fill / place / auto paths report "natives not resolved" instead of calling anything.
+auto ResolveNativeAddresses(const D2RL::PluginContext* context) noexcept -> bool {
+	g_nativesResolved = false;
+	g_nativeRvas      = BeltNatives::Resolved {};
+	size_t imageSize = 0;
+	size_t textRva   = 0;
+	size_t textSize  = 0;
+	if (g_moduleBase == 0 || !ImageText(g_moduleBase, imageSize, textRva, textSize)) {
+		g_nativeRvas.missing = "the game's .text section";
+		Log(context, "AutoBeltRefill: natives: OFF - the game's .text section was not found; the refill is off.");
+		return false;
+	}
+	g_nativeRvas = BeltNatives::Resolve(reinterpret_cast<const uint8_t*>(g_moduleBase), imageSize, textRva, textSize);
+	if (!g_nativeRvas.ok()) {
+		Log(context, "AutoBeltRefill: natives: OFF - pattern %s not found exactly once (or its checks failed) in this D2R build; "
+			"the refill is off, nothing is hooked or called.", g_nativeRvas.missing);
+		return false;
+	}
+	const auto at = [](BeltNatives::Id id) { return g_moduleBase + static_cast<uintptr_t>(g_nativeRvas.rva[id]); };
+	GetLocalDataContext   = reinterpret_cast<GetLocalDataContextFn>(at(BeltNatives::LocalDataContext));
+	GetLocalPlayer        = reinterpret_cast<GetLocalPlayerFn>(at(BeltNatives::LocalPlayer));
+	GetUnitInventory      = reinterpret_cast<GetUnitInventoryFn>(at(BeltNatives::UnitInventory));
+	GetItemData           = reinterpret_cast<GetItemDataFn>(at(BeltNatives::ItemData));
+	GetUnitType           = reinterpret_cast<GetUnitTypeFn>(at(BeltNatives::UnitType));
+	GetFirstItem          = reinterpret_cast<GetFirstItemFn>(at(BeltNatives::FirstItem));
+	GetNextItem           = reinterpret_cast<GetNextItemFn>(at(BeltNatives::NextItem));
+	GetItemCode           = reinterpret_cast<GetItemCodeFn>(at(BeltNatives::ItemCode));
+	GetFreeBeltSlotDirect = reinterpret_cast<GetFreeBeltSlotFn>(at(BeltNatives::FreeBeltSlot)); // v0.35.9: direct, unhooked
+	g_nativesResolved     = true;
+	char   list[640] {};
+	size_t used = 0;
+	for (const BeltNatives::Sig& sig : BeltNatives::Sigs) {
+		const int64_t rva = g_nativeRvas.rva[sig.id];
+		const int written = rva >= 0 ? std::snprintf(list + used, sizeof(list) - used, "%s%s 0x%llX", used ? ", " : "", sig.name,
+		                                             static_cast<unsigned long long>(rva))
+		                             : std::snprintf(list + used, sizeof(list) - used, "%s%s not found (optional)",
+		                                             used ? ", " : "", sig.name);
+		if (written < 0 || static_cast<size_t>(written) >= sizeof(list) - used) {
+			break;
+		}
+		used += static_cast<size_t>(written);
+	}
+	Log(context, "AutoBeltRefill: natives: patterns resolved: %s.", list);
+	return true;
+}
