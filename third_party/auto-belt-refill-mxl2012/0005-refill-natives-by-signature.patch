+#pragma once
+
+// The game routines the refill drives, found by byte signatures in the game's .text at load instead of one D2R build's
+// fixed addresses. Pure logic (no game access, no Windows headers), so it has unit tests (belt_match_tests.cpp).
+//
+// Every signature was taken from D2R 3.3 build 93847 (image 0x6ab3782c, the same image under 3.4 95032); rva93847 is that
+// build's address, kept only for logs and the dump test. Rules: each signature must match exactly once in .text; the target
+// must lie inside .text; where given, the target's own entry bytes must match `entry`, and the rel32 calls listed in `calls`
+// must point to routines resolved before it. A required signature that fails leaves every address unresolved (the refill
+// stays off); the optional one (Pickup, only reported by belt-verify) just stays unresolved.
+
+#include <cstddef>
+#include <cstdint>
+
+// The repo's signature scan (invtabs/src, the same helper as the tab and summary plugins): ParsePattern / FindPattern /
+// RipTarget. Pure, standard headers only.
+#include "invtabs_logic.h"
+
+namespace BeltNatives {
+
+enum Id : int {
+	LocalPlayer,
+	LocalDataContext,
+	UnitInventory,
+	UnitType,
+	ItemData,
+	FirstItem,
+	NextItem,
+	ItemCode,
+	FreeBeltSlot,
+	CanPutInBelt,
+	BeltTransfer,
+	Pickup,
+	Count
+};
+
+struct CallCheck {
+	int offset = -1; // rel32 at match + offset
+	int target = -1; // must point to this routine
+};
+
+struct Sig {
+	Id            id;
+	const char*   name;
+	const char*   pattern;
+	int           rip;    // >= 0: the rel32 / disp32 at this offset in the match is the routine
+	std::int64_t  adjust; // else the routine starts at the match + adjust
+	const char*   entry;  // the routine's own first bytes, checked at the target (nullptr: the match is the entry)
+	CallCheck     calls[2];
+	bool          required;
+	std::uint64_t rva93847;
+};
+
+// In resolution order: a call check names only routines above it.
+inline constexpr Sig Sigs[Count] = {
+	// GetLocalPlayer(context): `cmp ecx, 8; jae` on the client slot, then the player table.
