+// Does `pattern` match at image[at] (inside [0, size))?
+inline auto MatchesAt(const std::uint8_t* image, std::size_t size, std::size_t at, const char* pattern) -> bool {
+	const auto bytes = invtabs::ParsePattern(pattern);
+	if (bytes.empty() || at > size || size - at < bytes.size()) {
+		return false;
+	}
+	for (std::size_t k = 0; k < bytes.size(); ++k) {
+		if (bytes[k] >= 0 && image[at + k] != static_cast<std::uint8_t>(bytes[k])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+// One routine: -1 when its signature does not match exactly once or a check fails.
+inline auto ResolveOne(const std::uint8_t* image, std::size_t textRva, std::size_t textSize, const Sig& sig,
+                       const std::int64_t (&rva)[Count]) -> std::int64_t {
+	const auto hits = invtabs::FindPattern(image + textRva, textSize, invtabs::ParsePattern(sig.pattern), 2);
+	if (hits.size() != 1) {
+		return -1;
+	}
+	const std::size_t  at     = textRva + hits.front();
+	const std::int64_t target = sig.rip >= 0 ? invtabs::RipTarget(image, at + static_cast<std::size_t>(sig.rip))
+	                                         : static_cast<std::int64_t>(at) + sig.adjust;
+	const auto         inText = [&](std::int64_t r) {
+		return r >= static_cast<std::int64_t>(textRva) && r < static_cast<std::int64_t>(textRva + textSize);
+	};
+	if (target < 0 || !inText(target)) {
+		return -1;
+	}
+	if (sig.entry != nullptr && !MatchesAt(image, textRva + textSize, static_cast<std::size_t>(target), sig.entry)) {
+		return -1;
+	}
+	for (const CallCheck& call : sig.calls) {
+		if (call.offset < 0) {
+			continue;
+		}
+		if (call.target < 0 || call.target >= Count || rva[call.target] < 0
+		    || invtabs::RipTarget(image, at + static_cast<std::size_t>(call.offset)) != rva[call.target]) {
+			return -1;
+		}
+	}
+	return target;
+}
+
+// Every routine in the image (`image`, `imageSize` bytes, .text at `textRva`, `textSize`). The routines must be distinct.
+inline auto Resolve(const std::uint8_t* image, std::size_t imageSize, std::size_t textRva, std::size_t textSize) -> Resolved {
+	Resolved out;
+	static_assert(Count == 12, "Resolved::rva's initialiser lists one -1 per routine");
+	if (image == nullptr || textRva >= imageSize || textSize > imageSize - textRva) {
+		out.missing = "image";
+		return out;
+	}
+	for (const Sig& sig : Sigs) {
+		std::int64_t target = ResolveOne(image, textRva, textSize, sig, out.rva);
+		for (int other = 0; other < Count && target >= 0; ++other) {
+			if (out.rva[other] == target) {
+				target = -1; // two routines at one address: a signature found the wrong one
+			}
+		}
+		out.rva[sig.id] = target;
+		if (target < 0 && sig.required) {
+			for (auto& r : out.rva) {
+				r = -1;
+			}
+			out.missing = sig.name;
+			return out;
+		}
+	}
+	return out;
+}
+
