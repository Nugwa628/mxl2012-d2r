+// ---- the counts as D2R's own HUD text (0006) ----
+// D2RLoader's overlay text never reached the screen on this game (drawText Success, nothing drawn: docs/bugs.md #567, and the
+// owner saw no count in 0.1.15 - 0.1.23). The counts are now text boxes of D2R's own HUD: D2R-XL 2012's hudpanelhd.json /
+// hudpanel.json (tools/ui_layouts.py `hud_*`) add, after the belt, two boxes per column on the bottom-row cell, right-aligned
+// on the hotkey letter's line: `MxlBeltCount<c>` (white) and `MxlBeltCountZero<c>` (red). The plugin fills one of them through
+// D2R's own text setter on the UI thread and empties the other. Without those boxes (another mod) nothing shows.
+inline constexpr const char* HudPanelName = "HUDPanel";
+
+struct CountBoxTexts {
+	char white[4];
+	char red[4];
+};
+
+// The two boxes of a column: no code (empty column, elixir) = both empty; 0 left = "0" in red; else the count in white.
+constexpr auto BoxTexts(uint32_t code, uint32_t count) noexcept -> CountBoxTexts {
+	CountBoxTexts out {};
+	if (code == 0) {
+		return out;
+	}
+	if (count == 0) {
+		CountText(0, out.red);
+	} else {
+		CountText(count, out.white);
+	}
+	return out;
+}
+
+// `MxlBeltCount<column>` / `MxlBeltCountZero<column>` (column 0..3).
+inline auto BoxName(bool zero, uint32_t column, char (&out)[24]) noexcept -> const char* {
+	const char* stem = zero ? "MxlBeltCountZero" : "MxlBeltCount";
+	std::size_t at = 0;
+	for (; stem[at] != '\0' && at + 2 < sizeof(out); ++at) {
+		out[at] = stem[at];
+	}
+	out[at++] = static_cast<char>('0' + column % 10);
+	out[at] = '\0';
+	return out;
+}
+
+// D2R's UI root, panel lookup, child lookup and text setter, by the repo's signatures (invtabs/src/summary_natives.h: the
+// same functions plugin/src/devmenu.cpp and the charm summary use; 93847 0x3440170, 0x89f760, 0x855c90, 0x86dd50).
+struct TextNatives {
+	std::int64_t uiRoot    = -1; // data: void* the root widget
+	std::int64_t findPanel = -1; // void* (void* root, const char name[128])
+	std::int64_t findChild = -1; // void* (void* widget, const char* name)
+	std::int64_t setText   = -1; // void (void* textBox, const {const char*, size_t}* text)
+	const char*  missing   = nullptr;
+	auto ok() const noexcept -> bool { return missing == nullptr; }
+};
+
+// Each signature must match exactly once; the root must be data outside .text, the three functions distinct and in .text.
+inline auto ResolveTextNatives(const std::uint8_t* image, std::size_t imageSize, std::size_t textRva, std::size_t textSize) noexcept
+	-> TextNatives {
+	namespace S = invtabs::summary;
+	const auto fail = [](const char* name) {
+		TextNatives none;
+		none.missing = name;
+		return none;
+	};
+	if (image == nullptr || textRva >= imageSize || textSize > imageSize - textRva) {
+		return fail("image");
+	}
+	const auto inText = [&](std::int64_t rva) {
+		return rva >= 0 && static_cast<std::size_t>(rva) >= textRva && static_cast<std::size_t>(rva) < textRva + textSize;
+	};
+	TextNatives out;
+	const std::int64_t root = invtabs::ResolveNative(image, textRva, textSize, S::SummaryPatterns[S::UiRoot]);
+	if (root < 0 || inText(root) || static_cast<std::size_t>(root) > imageSize - 8) {
+		return fail(S::SummaryPatterns[S::UiRoot].name);
+	}
+	std::int64_t* fns[3] = {&out.findPanel, &out.findChild, &out.setText};
+	const int     ids[3] = {S::UiFindPanel, S::UiFindChild, S::TextBoxSetText};
+	for (int k = 0; k < 3; ++k) {
+		*fns[k] = invtabs::ResolveNative(image, textRva, textSize, S::SummaryPatterns[ids[k]]);
+		if (!inText(*fns[k])) {
+			return fail(S::SummaryPatterns[ids[k]].name);
+		}
+	}
+	if (out.findPanel == out.findChild || out.findPanel == out.setText || out.findChild == out.setText) {
+		return fail("UI functions not distinct");
+	}
+	out.uiRoot = root;
+	return out;
+}
+
 } // namespace BeltMatch
