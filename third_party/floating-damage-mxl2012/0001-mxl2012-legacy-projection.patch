@@ -0,0 +1,82 @@
+#pragma once
+
+// D2R-XL 2012 addition (third_party/floating-damage-mxl2012 in the D2R-XL 2012 repository, MIT like this plugin):
+// where a monster stands on the screen in D2R's legacy (classic) graphics.
+//
+// In legacy graphics D2R runs the classic engine: it draws the world into a fixed classic screen (800x600 or 640x480,
+// 1066x600 / 853x480 with the D2R Legacy 16:9 plugin) and composes that picture into the window fitted to the window
+// height and centred (side bars when the window is wider). A unit is drawn at its client pixel position minus the view
+// offset (the same two helpers every classic unit draw calls), so the plugin does the same and then maps the classic
+// point into the window like the compose pass. The HD camera projection is not used there: it describes the 3D view,
+// which the legacy picture does not show.
+//
+// Pure code (no Windows or D2RLoader headers): tests/floating_damage_mxl_tests.cpp checks it without the game.
+
+#include <cmath>
+#include <cstdint>
+
+namespace FloatingDamageMxl {
+
+// Classic pixels between a unit's feet and the place its number starts: about the height of a man-sized monster in
+// the classic sprites, so the number starts at the upper body like the HD head anchor.
+constexpr int LegacyHeadOffset = 56;
+
+struct ClassicPoint {
+    float x;
+    float y;
+};
+
+// The classic screen point of a unit: its client pixel position minus the view offset (what the classic draw code
+// does), raised by the head offset.
+constexpr ClassicPoint ClassicUnitPoint(
+    std::int32_t pixelX,
+    std::int32_t pixelY,
+    std::int32_t viewOffsetX,
+    std::int32_t viewOffsetY,
+    std::int32_t headOffset = LegacyHeadOffset) noexcept {
+    return ClassicPoint{
+        static_cast<float>(pixelX - viewOffsetX),
+        static_cast<float>(pixelY - viewOffsetY - headOffset),
+    };
+}
+
+// The classic screen size is usable: both sides positive and not larger than any classic mode (the widest is 16:9
+// at 600 high), so a stray read never turns into a huge scale.
+constexpr bool ClassicSizeValid(std::int32_t width, std::int32_t height) noexcept {
+    return width > 0 && height > 0 && width <= 4096 && height <= 2048;
+}
+
+// A classic screen point in window (display) pixels: the compose pass fits the classic picture to the display height
+// and centres it. False when a size is unusable, the result is not finite, or it falls outside the display.
+inline bool ClassicToDisplay(
+    float classicX,
+    float classicY,
+    std::int32_t classicWidth,
+    std::int32_t classicHeight,
+    float displayWidth,
+    float displayHeight,
+    float& outX,
+    float& outY) noexcept {
+    if (!ClassicSizeValid(classicWidth, classicHeight)
+            || !(displayWidth > 0.0f) || !(displayHeight > 0.0f)) {
+        return false;
+    }
+    const float scale = displayHeight / static_cast<float>(classicHeight);
+    const float left = (displayWidth - static_cast<float>(classicWidth) * scale) * 0.5f;
+    const float x = left + classicX * scale;
+    const float y = classicY * scale;
+    if (!std::isfinite(x) || !std::isfinite(y)
+            || x < 0.0f || x > displayWidth || y < 0.0f || y > displayHeight) {
+        return false;
+    }
+    outX = x;
+    outY = y;
+    return true;
+}
+
+// The target of a rip-relative operand: the address after the instruction plus the signed 32-bit displacement.
+constexpr std::uint64_t RipTarget(std::uint64_t nextInstruction, std::int32_t displacement) noexcept {
+    return nextInstruction + static_cast<std::uint64_t>(static_cast<std::int64_t>(displacement));
+}
+
+}  // namespace FloatingDamageMxl
