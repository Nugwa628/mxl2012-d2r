+// Legacy graphics: true when the game draws the classic picture (D2R's own HD test says no). False when the legacy
+// projection is off (its expected bytes did not match) or the test faults.
+bool InLegacyGraphics() noexcept {
+    if (!LegacyProjectionReady.load(std::memory_order_acquire) || !IsHd)
+        return false;
+    __try {
+        return IsHd() == 0;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+}
