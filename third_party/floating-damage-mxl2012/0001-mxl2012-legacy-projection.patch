+// The requested targets in legacy graphics, on the camera update (the view offset was just set for this frame): the
+// classic screen point each unit is drawn at (legacy_projection.hpp), cached like the HD points but marked legacy.
+void ProjectRequestedTargetsLegacy(std::uint64_t now) noexcept {
+    if (!GetClientUnit || ProjectionSweepActive)
+        return;
+    std::uint64_t previous = LastProjectionSweepTick.load(
+        std::memory_order_relaxed);
+    if (now - previous < ProjectionSweepIntervalMs
+            || !LastProjectionSweepTick.compare_exchange_strong(
+                previous, now, std::memory_order_acq_rel)) {
+        return;
+    }
+
+    std::int32_t viewX{};
+    std::int32_t viewY{};
+    std::int32_t classicWidth{};
+    std::int32_t classicHeight{};
+    __try {
+        viewX = ViewOffsetX();
+        viewY = ViewOffsetY();
+        classicWidth = *ClassicScreenWidth;
+        classicHeight = *ClassicScreenHeight;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER) {
+        return;
+    }
+    if (!FloatingDamageMxl::ClassicSizeValid(classicWidth, classicHeight))
+        return;
+    CachedClassicWidth.store(classicWidth, std::memory_order_release);
+    CachedClassicHeight.store(classicHeight, std::memory_order_release);
+
+    ProjectionSweepActive = true;
+    for (ProjectionRequestSlot& slot : ProjectionRequests) {
+        if (slot.writing.test(std::memory_order_acquire))
+            continue;
+        const std::uint64_t key = slot.key.load(std::memory_order_acquire);
+        const std::uint64_t requestedUntil = slot.requestedUntil.load(
+            std::memory_order_acquire);
+        if (key == 0 || requestedUntil < now
+                || slot.writing.test(std::memory_order_acquire)
+                || slot.key.load(std::memory_order_acquire) != key) {
+            continue;
+        }
+
+        const std::uint32_t unitType = static_cast<std::uint32_t>(key >> 32);
+        const std::uint32_t unitId = static_cast<std::uint32_t>(key);
+        bool projected{};
+        __try {
+            UnitView* target = GetClientUnit(unitId, unitType);
+            if (target) {
+                const FloatingDamageMxl::ClassicPoint classic =
+                    FloatingDamageMxl::ClassicUnitPoint(
+                        UnitPixelX(target), UnitPixelY(target), viewX, viewY);
+                CacheNativeProjection(
+                    target, NativeScreenPoint{classic.x, classic.y}, true, true);
+                projected = true;
+            }
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER) {
+            projected = false;
+        }
+
+        ActiveProjectionAttempts.fetch_add(1, std::memory_order_relaxed);
+        if (projected) {
+            LegacyProjections.fetch_add(1, std::memory_order_relaxed);
+        }
+        else {
+            ActiveProjectionMisses.fetch_add(1, std::memory_order_relaxed);
+            CacheNativeProjectionFailure(unitType, unitId, now);
+        }
+    }
+    ProjectionSweepActive = false;
+}
