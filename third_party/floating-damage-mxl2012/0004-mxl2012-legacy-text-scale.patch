index 84b94d4..d38b2f2 100644
--- a/plugins/floating-damage/src/legacy_projection.hpp
+++ b/plugins/floating-damage/src/legacy_projection.hpp
@@ -149,6 +149,12 @@ inline void PlaceInArea(
     centerY = y;
 }
 
+// A number's text size: in legacy graphics the classic picture's sprites are far bigger than HD's at the same window
+// height, so the numbers get the config's legacy_text_scale there. HD keeps the size it is given.
+inline float LegacyNumberSize(float size, bool legacy, float legacyScale) noexcept {
+    return legacy ? size * legacyScale : size;
+}
+
 // The target of a rip-relative operand: the address after the instruction plus the signed 32-bit displacement.
 constexpr std::uint64_t RipTarget(std::uint64_t nextInstruction, std::int32_t displacement) noexcept {
     return nextInstruction + static_cast<std::uint64_t>(static_cast<std::int64_t>(displacement));
