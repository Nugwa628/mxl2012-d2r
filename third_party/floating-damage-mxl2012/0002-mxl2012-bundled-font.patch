+// D2R-XL 2012: ruffneckk-floating-damage-font.ttf in the folder of this DLL, or empty.
+std::filesystem::path FindFontNextToModule() noexcept {
+    try {
+        std::wstring path(MAX_PATH, L'\0');
+        for (;;) {
+            const DWORD length = GetModuleFileNameW(Module, path.data(), static_cast<DWORD>(path.size()));
+            if (length == 0) return {};
+            if (length < path.size()) {
+                path.resize(length);
+                break;
+            }
+            path.resize(path.size() * 2);
+        }
+        const auto candidate = std::filesystem::path(path).parent_path() / L"ruffneckk-floating-damage-font.ttf";
+        std::error_code error;
+        if (std::filesystem::is_regular_file(candidate, error) && !error)
+            return candidate;
+    }
+    catch (...) {
+    }
+    return {};
+}
