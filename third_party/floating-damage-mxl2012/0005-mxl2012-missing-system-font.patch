diff --git a/plugins/floating-damage/src/font_loading.hpp b/plugins/floating-damage/src/font_loading.hpp
new file mode 100644
index 0000000..0b0f79d
--- /dev/null
+++ b/plugins/floating-damage/src/font_loading.hpp
@@ -0,0 +1,74 @@
+#pragma once
+
+// D2R-XL 2012 addition (third_party/floating-damage-mxl2012 in the D2R-XL 2012 repository, MIT like this plugin):
+// loading the overlay's fonts without crashing when a Windows font is missing (Proton / Wine prefixes, trimmed Windows
+// installs).
+//
+// Dear ImGui 1.91.5 reports a font file it cannot open (ImFontAtlas::AddFontFromFileTTF) as a recoverable user error:
+// ErrorLog shows it in an error tooltip, which calls ImGui::Begin. The renderer loads its fonts right after creating its
+// ImGui context, outside any frame and before any font is built, so that Begin reads a null g.Font and the game's Present
+// fails with an access violation. A Proton prefix has no segoeui.ttf (index 0), so the first hooked Present crashed there.
+// AddFontFileIfPresent reads the file the same way but returns nullptr instead, and the caller's fallback (ImGui's
+// built-in font) takes over; it also refuses a file that does not start like a font (stb_truetype reads such data out of
+// bounds in a release build). BuildFontAtlasOrDefault builds the atlas before the backend uploads it; when Dear ImGui
+// cannot build it (a font file without the tables it needs), the atlas keeps ImGui's built-in font only.
+
+#include <imgui.h>
+#include <imgui_internal.h>
+
+#include <cstddef>
+#include <cstring>
+
+namespace FloatingDamageMxl {
+
+// The signatures stb_truetype accepts (stbtt__isfont: TrueType 1, Type 1, OpenType CFF, TrueType 1.0, Apple "true") and a
+// TrueType collection. AddFontFromMemoryTTF also wants more than 100 bytes.
+inline bool IsFontData(const unsigned char* data, std::size_t size) noexcept {
+    if (data == nullptr || size <= 100) return false;
+    const auto tag = [data](char a, char b, char c, char d) {
+        return data[0] == static_cast<unsigned char>(a) && data[1] == static_cast<unsigned char>(b)
+            && data[2] == static_cast<unsigned char>(c) && data[3] == static_cast<unsigned char>(d);
+    };
+    return tag('1', 0, 0, 0) || tag('t', 'y', 'p', '1') || tag('O', 'T', 'T', 'O') || tag(0, 1, 0, 0)
+        || tag('t', 'r', 'u', 'e') || tag('t', 't', 'c', 'f');
+}
+
+// ImFontAtlas::AddFontFromFileTTF without the user-error report: nullptr when the file cannot be read or is no font,
+// otherwise the same font from the same bytes (the atlas owns them; the font gets the file name and size as its name when
+// it has none).
+inline ImFont* AddFontFileIfPresent(
+        ImFontAtlas* atlas,
+        const char* path,
+        float sizePixels,
+        const ImFontConfig* configTemplate,
+        const ImWchar* glyphRanges) noexcept {
+    if (atlas == nullptr || path == nullptr || path[0] == '\0') return nullptr;
+    std::size_t size = 0;
+    void* const data = ImFileLoadToMemory(path, "rb", &size, 0);
+    if (data == nullptr) return nullptr;
+    if (!IsFontData(static_cast<const unsigned char*>(data), size)) {
+        IM_FREE(data);
+        return nullptr;
+    }
+    ImFontConfig config = configTemplate != nullptr ? *configTemplate : ImFontConfig();
+    if (config.Name[0] == '\0') {
+        const char* name = path + std::strlen(path);
+        while (name > path && name[-1] != '/' && name[-1] != '\\') --name;
+        ImFormatString(config.Name, IM_ARRAYSIZE(config.Name), "%s, %.0fpx", name, sizePixels);
+    }
+    return atlas->AddFontFromMemoryTTF(data, static_cast<int>(size), sizePixels, &config, glyphRanges);
+}
+
+// Builds the atlas now (what the backend's texture upload would do). When that fails, the atlas is cleared, gets ImGui's
+// built-in font and is built again; fellBack tells the caller that every font it added is gone. False only when even
+// the built-in font cannot be built.
+inline bool BuildFontAtlasOrDefault(ImFontAtlas* atlas, bool& fellBack) noexcept {
+    fellBack = false;
+    if (atlas == nullptr) return false;
+    if (atlas->Build()) return true;
+    fellBack = true;
+    atlas->Clear();
+    return atlas->AddFontDefault() != nullptr && atlas->Build();
+}
+
+} // namespace FloatingDamageMxl
