+// The classic HUD (the control panel with the globes): 800 classic pixels wide, centred on the classic screen, and this
+// many classic pixels high at the bottom, globes included.
+constexpr int LegacyHudWidth = 800;
+constexpr int LegacyHudHeight = 104;
+
+struct DisplayRect {
+    float left;
+    float top;
+    float right;
+    float bottom;
+};
+
+// Legacy graphics: the classic picture in window pixels (fitted to the window height and centred) and the classic HUD
+// inside it. False when a size is unusable.
+inline bool LegacyFrame(
+    std::int32_t classicWidth,
+    std::int32_t classicHeight,
+    float displayWidth,
+    float displayHeight,
+    DisplayRect& frame,
+    DisplayRect& hud) noexcept {
+    if (!ClassicSizeValid(classicWidth, classicHeight)
+            || !(displayWidth > 0.0f) || !(displayHeight > 0.0f)) {
+        return false;
+    }
+    const float scale = displayHeight / static_cast<float>(classicHeight);
+    const float left = (displayWidth - static_cast<float>(classicWidth) * scale) * 0.5f;
+    frame = DisplayRect{left, 0.0f, left + static_cast<float>(classicWidth) * scale, displayHeight};
+    const float hudWidth = static_cast<float>(
+        classicWidth < LegacyHudWidth ? classicWidth : LegacyHudWidth) * scale;
+    const float hudLeft = left + (static_cast<float>(classicWidth) * scale - hudWidth) * 0.5f;
+    hud = DisplayRect{hudLeft, displayHeight - static_cast<float>(LegacyHudHeight) * scale, hudLeft + hudWidth, displayHeight};
+    return true;
+}
+
+// The centre of a text block of the given size placed at xPercent / yPercent of an area, kept inside the area by the
+// margins and, when it would cover the HUD, moved up above it (the DPS counter's placement).
+inline void PlaceInArea(
+    const DisplayRect& area,
+    const DisplayRect* hud,
+    float xPercent,
+    float yPercent,
+    float blockWidth,
+    float blockHeight,
+    float horizontalMargin,
+    float verticalMargin,
+    float& centerX,
+    float& centerY) noexcept {
+    const float width = area.right - area.left;
+    const float height = area.bottom - area.top;
+    float x = area.left + width * xPercent / 100.0f;
+    float y = area.top + height * yPercent / 100.0f;
+    if (xPercent <= 10.0f)
+        x += blockWidth * 0.5f + horizontalMargin;
+    else if (xPercent >= 90.0f)
+        x -= blockWidth * 0.5f + horizontalMargin;
+    if (yPercent <= 10.0f)
+        y += blockHeight * 0.5f + verticalMargin;
+    else if (yPercent >= 90.0f)
+        y -= blockHeight * 0.5f + verticalMargin;
+    const auto clamp = [](float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); };
+    x = blockWidth + 2.0f * horizontalMargin <= width
+        ? clamp(x, area.left + horizontalMargin + blockWidth * 0.5f, area.right - horizontalMargin - blockWidth * 0.5f)
+        : area.left + width * 0.5f;
+    y = blockHeight + 2.0f * verticalMargin <= height
+        ? clamp(y, area.top + verticalMargin + blockHeight * 0.5f, area.bottom - verticalMargin - blockHeight * 0.5f)
+        : area.top + height * 0.5f;
+    if (hud && x + blockWidth * 0.5f > hud->left && x - blockWidth * 0.5f < hud->right
+            && y + blockHeight * 0.5f > hud->top - verticalMargin) {
+        y = hud->top - verticalMargin - blockHeight * 0.5f;
+    }
+    centerX = x;
+    centerY = y;
+}
