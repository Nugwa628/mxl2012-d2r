index 0000000..8e38912
--- /dev/null
+++ b/plugins/floating-damage/src/general_key.hpp
@@ -0,0 +1,63 @@
+#pragma once
+// D2R-XL 2012 (patch 0006): sets one boolean key of the [general] table in the plugin's TOML text, as the author's
+// SaveEnabled does for `enabled`, and keeps everything else (comments, order, line ends). A key the file does not have yet
+// (show_numbers in a file from before D2R-XL 2012 0.1.30) is added on the line after the [general] header. False when the
+// text has no [general] table.
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+
+namespace FloatingDamageMxl {
+
+inline bool SetGeneralBool(std::string& text, std::string_view key, bool value) {
+    const char* word = value ? "true" : "false";
+    const auto isSpace = [](char c) { return c == ' ' || c == '\t'; };
+    std::string section;
+    std::size_t headerEnd = std::string::npos;
+    bool headerCrlf = false;
+    for (std::size_t pos = 0; pos < text.size();) {
+        std::size_t end = text.find('\n', pos);
+        const std::size_t next = end == std::string::npos ? text.size() : end + 1;
+        if (end == std::string::npos) end = text.size();
+        std::size_t lineEnd = end;
+        const bool crlf = lineEnd > pos && text[lineEnd - 1] == '\r';
+        if (crlf) --lineEnd;
+        std::size_t a = pos;
+        while (a < lineEnd && isSpace(text[a])) ++a;
+        if (a < lineEnd && text[a] == '[') {
+            std::size_t b = text.find('#', a);
+            if (b == std::string::npos || b > lineEnd) b = lineEnd;
+            while (b > a && isSpace(text[b - 1])) --b;
+            section = text.substr(a, b - a);
+            if (section == "[general]" && headerEnd == std::string::npos) {
+                headerEnd = next;
+                headerCrlf = crlf;
+            }
+        } else if (section == "[general]" && a < lineEnd && text[a] != '#') {
+            const std::size_t eq = text.find('=', a);
+            if (eq != std::string::npos && eq < lineEnd) {
+                std::size_t k = eq;
+                while (k > a && isSpace(text[k - 1])) --k;
+                if (std::string_view(text).substr(a, k - a) == key) {
+                    std::size_t v = eq + 1;
+                    while (v < lineEnd && isSpace(text[v])) ++v;
+                    std::size_t ve = text.find('#', v);
+                    if (ve == std::string::npos || ve > lineEnd) ve = lineEnd;
+                    while (ve > v && isSpace(text[ve - 1])) --ve;
+                    text.replace(v, ve - v, word);
+                    return true;
+                }
+            }
+        }
+        pos = next;
+    }
+    if (headerEnd == std::string::npos) return false;
+    const char* eol = headerCrlf ? "\r\n" : "\n";
+    std::string line = std::string(key) + " = " + word + eol;
+    if (headerEnd > 0 && text[headerEnd - 1] != '\n') line = eol + line;
+    text.insert(headerEnd, line);
+    return true;
+}
+
+}  // namespace FloatingDamageMxl
