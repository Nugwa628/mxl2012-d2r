+// before it is written, as SaveEnabled does.
+bool SaveGeneralBool(std::string_view key, bool value) {
+    constexpr std::size_t MaximumConfigBytes = 65'536;
+    std::array<char, MaximumConfigBytes> buffer{};
+    std::uint32_t required{};
+    if (!Context->ReadConfig(
+            buffer.data(),
+            static_cast<std::uint32_t>(buffer.size()),
+            &required)) {
+        return false;
+    }
+    std::string text(buffer.data());
+    if (!FloatingDamageMxl::SetGeneralBool(text, key, value)) return false;
+    FloatingDamage::Config updated{};
+    std::string error;
+    if (!FloatingDamage::ParseConfigToml(text, updated, error)) return false;
+    if ((key == "show_numbers" && updated.showNumbers != value)
+            || (key == "enabled" && updated.enabled != value)) {
+        return false;
+    }
+    return Context->WriteConfig(text.c_str());
+}
