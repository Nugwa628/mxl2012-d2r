+// D2R-XL 2012 (patch 0006): the mod's Controls action "Floating Damage Numbers" (mxl2012-core, overlay_keys.cpp) reads and
+// sets whether numbers show. Shown: 1 shown, 0 hidden, -1 not running (not loaded, or [general] enabled = false at the
+// start: no hooks). SetShown applies it at once and saves show_numbers (and enabled = true when it shows them); it returns
+// 1 applied and saved, 0 applied but not saved, -1 refused (not running).
+extern "C" __declspec(dllexport) int __cdecl Mxl2012FloatingDamageShownV1() noexcept {
+    if (Context == nullptr || !RuntimeActive.load(std::memory_order_acquire)) return -1;
+    return FloatingDamage::IsEnabled() ? 1 : 0;
+}
+
+extern "C" __declspec(dllexport) int __cdecl Mxl2012FloatingDamageSetShownV1(int shown) noexcept {
+    if (Context == nullptr || !RuntimeActive.load(std::memory_order_acquire)) return -1;
+    try {
+        const bool show = shown != 0;
+        if (show) FloatingDamage::SetEnabled(true);
+        FloatingDamage::SetShown(show);
+        bool saved = SaveGeneralBool("show_numbers", show);
+        if (saved && show) {
+            FloatingDamage::Config current{};
+            std::array<char, 65'536> buffer{};
+            std::uint32_t required{};
+            std::string error;
+            saved = Context->ReadConfig(buffer.data(), static_cast<std::uint32_t>(buffer.size()), &required)
+                && FloatingDamage::ParseConfigToml(std::string_view(buffer.data()), current, error)
+                && (current.enabled || SaveGeneralBool("enabled", true));
+        }
+        char message[128]{};
+        std::snprintf(message, sizeof(message), "FloatingDamage: show_numbers=%s set by D2R-XL 2012's Controls action%s.",
+            show ? "true" : "false", saved ? " and saved" : ", not saved");
+        Context->LogInfo(message);
+        return saved ? 1 : 0;
+    } catch (...) {
+        return 0;
+    }
+}
