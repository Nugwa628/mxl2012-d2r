diff --git a/src/legacy_projection.h b/src/legacy_projection.h
new file mode 100644
index 0000000..9d9dcca
--- /dev/null
+++ b/src/legacy_projection.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// D2R-XL 2012 addition: where a monster stands on the screen in D2R's legacy (classic) graphics, the same placement the
+// D2R-XL 2012 build of RuffnecKk's Floating Damage uses.
+//
+// In legacy graphics D2R runs the classic engine: it draws the world into a fixed classic screen (800x600 or 640x480,
+// 1066x600 / 853x480 with the D2R Legacy 16:9 plugin) and composes that picture into the window fitted to the window
+// height and centred (side bars when the window is wider). A unit is drawn at its client pixel position minus the view
+// offset (the two helpers every classic unit draw calls), so the bars do the same and then map the classic point into
+// the window like the compose pass. The HD camera projection describes the 3D view, which the legacy picture does not show.
+//
+// Pure code (no Windows or D2RLoader headers): policy_tests.cpp checks it without the game.
+#pragma once
+#include <cmath>
+#include <cstdint>
+namespace bars::legacy {
+// Classic pixels from a unit's feet to the top of a man-sized monster, for monster types without a size in monstats2.
+inline constexpr int kDefaultHeadHeight = 56;
+struct Point { float x, y; };
+// The classic screen point above a unit: its client pixel position minus the view offset, raised by its height.
+constexpr Point classicUnitPoint(int32_t pixelX, int32_t pixelY, int32_t viewX, int32_t viewY, int32_t headHeight) noexcept {
+    return Point{static_cast<float>(pixelX - viewX), static_cast<float>(pixelY - viewY - headHeight)};
+}
+// The height to raise a bar by: the monster type's classic pixel height (monstats2 pixHeight), else the default.
+constexpr int32_t headHeight(int pixHeight) noexcept {
+    return pixHeight > 0 && pixHeight < 2000 ? pixHeight : kDefaultHeadHeight;
+}
+// A usable classic screen size: both sides positive and not larger than any classic mode, so a stray read never turns
+// into a huge scale.
+constexpr bool classicSizeValid(int32_t width, int32_t height) noexcept {
+    return width > 0 && height > 0 && width <= 4096 && height <= 2048;
+}
+// A classic screen point in window pixels: the compose pass fits the classic picture to the window height and centres
+// it. False when a size is unusable, the result is not finite, or it falls outside the window.
+inline bool classicToDisplay(float x, float y, int32_t classicWidth, int32_t classicHeight, float displayWidth,
+                             float displayHeight, float& outX, float& outY) noexcept {
+    if (!classicSizeValid(classicWidth, classicHeight) || !(displayWidth > 0) || !(displayHeight > 0)) return false;
+    const float scale = displayHeight / static_cast<float>(classicHeight);
+    const float left = (displayWidth - static_cast<float>(classicWidth) * scale) * 0.5f;
+    const float dx = left + x * scale, dy = y * scale;
+    if (!std::isfinite(dx) || !std::isfinite(dy) || dx < 0 || dx > displayWidth || dy < 0 || dy > displayHeight) return false;
+    outX = dx;
+    outY = dy;
+    return true;
+}
+}  // namespace bars::legacy
