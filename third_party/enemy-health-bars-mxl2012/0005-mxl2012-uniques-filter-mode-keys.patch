+// mxl2012 0005: D2R-XL 2012's Controls action "Enemy Health Bars Mode" (mxl2012-core, overlay_keys.cpp) reads the mode and
+// sets it here. Set applies it at once (as `enemybars on/off`) and saves enabled, show_full_health and uniques_bosses_only
+// in enemy-health-bars.toml (mode_config.h). Mode bits: bars::mode (Valid, Enabled, Full, UniquesOnly); 0 = not loaded.
+// Set returns 1 applied and saved, 0 applied but not saved, -1 refused.
+D2RL_PLUGIN_EXPORT uint32_t __cdecl Mxl2012EnemyBarsModeV1() noexcept {
+    if(!pluginContext||stopped)return 0;
+    std::lock_guard lock(guard);return bars::mode::pack(config.enabled,config.full,config.uniquesOnly);
+}
+D2RL_PLUGIN_EXPORT int __cdecl Mxl2012EnemyBarsSetModeV1(uint32_t mode) noexcept {
+    if(!pluginContext||stopped||!(mode&bars::mode::Valid))return -1;
+    try {
+        {
+            std::lock_guard lock(guard);
+            config.enabled=(mode&bars::mode::Enabled)!=0;config.full=(mode&bars::mode::Full)!=0;
+            config.uniquesOnly=(mode&bars::mode::UniquesOnly)!=0;
+            bars::standalone::setEnabled(config.enabled);
+        }
+        std::array<char,16384> buffer{};
+        if(!pluginContext->ReadConfig(buffer.data(),static_cast<uint32_t>(buffer.size())))return 0;
+        std::string text(buffer.data());
+        if(!bars::mode::setMode(text,mode)||!pluginContext->WriteConfig(text.c_str()))return 0;
+        char msg[160];std::snprintf(msg,sizeof(msg),"Enemy bars: mode set and saved (enabled=%d show_full_health=%d uniques_bosses_only=%d).",
+            (mode&bars::mode::Enabled)?1:0,(mode&bars::mode::Full)?1:0,(mode&bars::mode::UniquesOnly)?1:0);
+        pluginContext->LogInfo(msg);
+        return 1;
+    }catch(...){return 0;}
+}
 D2RL_PLUGIN_EXPORT void D2RLoaderUnloadPlugin() noexcept {
     stopped=true;
     bars::standalone::stop();
