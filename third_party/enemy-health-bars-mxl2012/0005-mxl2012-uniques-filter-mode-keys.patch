@@ -30,6 +30,11 @@ inline bool eligible(uint32_t type, uint32_t mode, uint32_t flags, bool hostile,
 inline bool shown(bool fullHealth, float ratio) {
     return fullHealth || ratio < 1.0f;
 }
+// mxl2012 0005: uniques_bosses_only = true keeps bars only on uniques, super uniques and bosses (the monsters with the
+// orange outline, Rarity::Unique); normal monsters, champions and the minions of a unique get none.
+inline bool shownFor(bool fullHealth, bool uniquesOnly, float ratio, Rarity kind) {
+    return shown(fullHealth, ratio) && (!uniquesOnly || kind == Rarity::Unique);
+}
 inline float lifeRatio(int clientLife) {
     // Client monster stat 6 is a normalized 0..32768 value, not absolute HP.
     return std::clamp(clientLife / 32768.0f, 0.0f, 1.0f);
