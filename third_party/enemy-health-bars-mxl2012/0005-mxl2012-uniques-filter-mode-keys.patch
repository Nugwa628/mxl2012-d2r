+// SPDX-License-Identifier: GPL-3.0-only
+// mxl2012 0005: the bars' mode as D2R-XL 2012's Controls action "Enemy Health Bars Mode" (mxl2012-core) sets it, through the
+// exports Mxl2012EnemyBarsModeV1 / Mxl2012EnemyBarsSetModeV1 of plugin.cpp. The mode is three keys of [bars]: enabled,
+// show_full_health and uniques_bosses_only. setKey rewrites one of them in the player's file and keeps everything else
+// (comments, order, line ends); a key the file does not have yet (uniques_bosses_only in a file from before 0.1.30) is
+// added on the line after the [bars] header.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string>
+namespace bars::mode {
+inline constexpr uint32_t Valid = 0x80000000u, Enabled = 1, Full = 2, UniquesOnly = 4;
+inline uint32_t pack(bool enabled, bool full, bool uniquesOnly) {
+    return Valid | (enabled ? Enabled : 0) | (full ? Full : 0) | (uniquesOnly ? UniquesOnly : 0);
+}
+inline bool setKey(std::string& text, const std::string& key, bool value) {
+    const char* word = value ? "true" : "false";
+    auto isSpace = [](char c) { return c == ' ' || c == '\t'; };
+    std::string section;
+    size_t barsLineEnd = std::string::npos;  // the end of the [bars] header line, newline included
+    bool barsCrlf = false;
+    for (size_t pos = 0; pos < text.size();) {
+        size_t end = text.find('\n', pos);
+        const size_t next = end == std::string::npos ? text.size() : end + 1;
+        if (end == std::string::npos) end = text.size();
+        size_t lineEnd = end;
+        const bool crlf = lineEnd > pos && text[lineEnd - 1] == '\r';
+        if (crlf) --lineEnd;
+        size_t a = pos;
+        while (a < lineEnd && isSpace(text[a])) ++a;
+        if (a < lineEnd && text[a] == '[') {
+            size_t b = lineEnd;
+            while (b > a && isSpace(text[b - 1])) --b;
+            section = text.substr(a, b - a);
+            if (section == "[bars]" && barsLineEnd == std::string::npos) { barsLineEnd = next; barsCrlf = crlf; }
+        } else if (section == "[bars]" && a < lineEnd && text[a] != '#') {
+            const size_t eq = text.find('=', a);
+            if (eq != std::string::npos && eq < lineEnd) {
+                size_t k = eq;
+                while (k > a && isSpace(text[k - 1])) --k;
+                if (text.compare(a, k - a, key) == 0 && k - a == key.size()) {
+                    size_t v = eq + 1;
+                    while (v < lineEnd && isSpace(text[v])) ++v;
+                    size_t ve = text.find('#', v);
+                    if (ve == std::string::npos || ve > lineEnd) ve = lineEnd;
+                    while (ve > v && isSpace(text[ve - 1])) --ve;
+                    text.replace(v, ve - v, word);
+                    return true;
+                }
+            }
+        }
+        pos = next;
+    }
+    if (barsLineEnd == std::string::npos) return false;
+    std::string line = key + " = " + word + (barsCrlf ? "\r\n" : "\n");
+    if (barsLineEnd > 0 && text[barsLineEnd - 1] != '\n') line = (barsCrlf ? "\r\n" : "\n") + line;  // header on the last line
+    text.insert(barsLineEnd, line);
+    return true;
+}
+inline bool setMode(std::string& text, uint32_t mode) {
+    return setKey(text, "enabled", (mode & Enabled) != 0) && setKey(text, "show_full_health", (mode & Full) != 0)
+        && setKey(text, "uniques_bosses_only", (mode & UniquesOnly) != 0);
+}
+}
