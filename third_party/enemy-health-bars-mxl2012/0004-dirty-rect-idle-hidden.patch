new file mode 100644
index 0000000..cd9cc1f
--- /dev/null
+++ b/src/present_plan.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// mxl2012 0004: what the standalone renderer sends to its layered window on each pass. Pure logic (no Windows calls), so
+// policy_tests can check it. The author's renderer sent the whole window (33 MB at 3840x2160) through UpdateLayeredWindow
+// on every pass, even with no bar on screen and with the bars turned off; under Wine/X11 that held the game to about 30 fps.
+// Here: the window is created only when the first bar is drawn; with nothing to draw it is hidden and nothing is sent; while
+// bars stay on screen only the area that changed is sent (what the window showed last time plus what is drawn now), so a bar
+// that moved or disappeared is cleared from the window's own surface and leaves no ghost. A window that was hidden gets one
+// whole send before it is shown again (Wine need not keep a hidden window's surface), so nothing old can show either.
+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace bars::present {
+struct Area {
+    int left{},top{},right{},bottom{};
+    bool empty() const {return left>=right||top>=bottom;}
+    bool operator==(const Area&) const=default;
+};
+inline Area unite(const Area& a,const Area& b) {
+    if(a.empty())return b;
+    if(b.empty())return a;
+    return {std::min(a.left,b.left),std::min(a.top,b.top),std::max(a.right,b.right),std::max(a.bottom,b.bottom)};
+}
+// The pixels a fill of (left, top, right, bottom) touches on a width x height target, clamped as rasterRect clamps it.
+inline Area pixels(float left,float top,float right,float bottom,int width,int height) {
+    if(width<=0||height<=0||!std::isfinite(left)||!std::isfinite(top)||!std::isfinite(right)||!std::isfinite(bottom))return {};
+    const Area a{static_cast<int>(std::clamp(std::floor(left),0.f,static_cast<float>(width))),
+                 static_cast<int>(std::clamp(std::floor(top),0.f,static_cast<float>(height))),
+                 static_cast<int>(std::clamp(std::ceil(right),0.f,static_cast<float>(width))),
+                 static_cast<int>(std::clamp(std::ceil(bottom),0.f,static_cast<float>(height)))};
+    return a.empty()?Area{}:a;
+}
+// What one pass does with the window, in this order: hide it; create it (hidden, the game's size); send `dirty` of the
+// bitmap; show it.
+struct Step {bool hide{},create{},send{},show{};Area dirty{};};
+class Presenter {
+public:
+    // Nothing may be shown this pass (bars off, no bar drawn, game not visible or not focused, no snapshot): hide the
+    // window, send nothing. The next send (before it is shown again) is the whole window.
+    Step idle() {Step s;if(shown){s.hide=true;shown=false;whole=true;}return s;}
+    // The bitmap was painted and now holds exactly `now` (nothing else: the last pass's area was cleared first).
+    Step frame(const Area& now,int width,int height) {
+        if(now.empty()||width<=0||height<=0)return idle();
+        Step s;
+        if(!haveWindow){s.create=true;haveWindow=true;whole=true;}
+        s.send=true;
+        s.dirty=whole?Area{0,0,width,height}:unite(onWindow,now);
+        if(!shown){s.show=true;shown=true;}
+        onWindow=now;whole=false;
+        return s;
+    }
+    // The bitmap was made again at a new size: the window's surface no longer matches it, the next send is the whole window.
+    void resized() {whole=true;onWindow={};}
+    // The window is gone (destroyed with the game window that owned it): the next bar creates a new one.
+    void windowLost() {haveWindow=false;shown=false;whole=true;onWindow={};}
+    bool hasWindow() const {return haveWindow;}
+    bool isShown() const {return shown;}
+private:
+    Area onWindow{};  // while shown: the part of the window's surface that may hold drawn pixels
+    bool haveWindow=false,shown=false,whole=true;
+};
+}
