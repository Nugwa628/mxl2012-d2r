diff --git a/plugins/controller-qol/src/hooked_entry_policy.h b/plugins/controller-qol/src/hooked_entry_policy.h
new file mode 100644
index 0000000..9f17968
--- /dev/null
+++ b/plugins/controller-qol/src/hooked_entry_policy.h
@@ -0,0 +1,16 @@
+#pragma once
+// D2R-XL 2012: its mxl2012-core plugin hooks the entry of 0x1A0780 (the client sound play these actions finish with; it
+// skips one sound of Median's spirit summons). The hook replaces only the first 13 bytes (the pushes and the frame set-up), so
+// the rest of the checked bytes still identify the function, and calls through the hook play every other sound as before.
+// Only those bytes are checked: a check of the hooked prologue would fail (and log an error) on every poll.
+#include "materials_signatures.h"
+#include <D2RLPlugin/context.h>
+namespace QolHookedEntry {
+inline constexpr uint64_t FinishRva=0x1a0780;
+inline constexpr uint32_t HookedPrologue=13;
+inline bool FinishInteractionAdmitted(const D2RL::PluginContext* ctx) noexcept {
+    using QolMaterials::Signatures::FinishInteraction;
+    return ctx && ctx->CheckExpectedBytes(FinishRva+HookedPrologue,FinishInteraction+HookedPrologue,
+        sizeof(FinishInteraction)-HookedPrologue);
+}
+}
