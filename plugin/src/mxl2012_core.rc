#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

// Version info: the D2R-XL 2012 Downloader finds copies of the plugin in other plugins folders by this too, also renamed ones
// (docs/bugs.md #53). The numbers come from PluginVersion in mxl2012_core.cpp through CMakeLists.txt.
1 VERSIONINFO  // 1 = VS_VERSION_INFO
 FILEVERSION MXL_PV_NUM
 PRODUCTVERSION MXL_PV_NUM
 FILEOS 0x40004  // VOS_NT_WINDOWS32
 FILETYPE 0x2  // VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "mxl2012-d2r"
			VALUE "FileDescription", "D2R-XL 2012 core plugin (mxl2012-core)"
			VALUE "FileVersion", MXL_PV_STR
			VALUE "ProductName", "D2R-XL 2012"
			VALUE "ProductVersion", MXL_PV_STR
			VALUE "OriginalFilename", "mxl2012-core.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
