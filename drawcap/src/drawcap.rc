#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>

// The plugin manifest: D2RLoader reads the plugin ABI from it before it loads the DLL (without it: "an old alpha plugin").
D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

// Version info; the numbers come from PluginVersion in drawcap.cpp through CMakeLists.txt.
1 VERSIONINFO  // 1 = VS_VERSION_INFO
 FILEVERSION DRAWCAP_PV_NUM
 PRODUCTVERSION DRAWCAP_PV_NUM
 FILEOS 0x40004  // VOS_NT_WINDOWS32
 FILETYPE 0x2  // VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "D2R-XL 2012"
			VALUE "FileDescription", "Draw List Cap (drawcap) D2RLoader plugin"
			VALUE "FileVersion", DRAWCAP_PV_STR
			VALUE "ProductName", "Draw List Cap"
			VALUE "ProductVersion", DRAWCAP_PV_STR
			VALUE "OriginalFilename", "drawcap.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
