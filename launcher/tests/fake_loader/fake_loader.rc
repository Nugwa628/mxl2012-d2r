// The version resource of the fake D2RLoader.exe (fake_loader.cpp): FileVersion as D2RLoader 1.3.1-beta's.
#include <winver.h>

1 VERSIONINFO
FILEVERSION 1,3,1,0
PRODUCTVERSION 1,3,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "fake D2RLoader for the downloader's tests"
			VALUE "FileVersion", "1.3.1-beta"
			VALUE "ProductVersion", "1.3.1-beta"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
